<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph.xml"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.androidfinal.core.ui.fragments.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.androidfinal.core.ui.fragments.DetailFragment"
        android:label="DetailFragment"
        >
        <argument
            android:name="article"
            app:argType="com.example.androidfinal.core.data.db.NewsArticleEntity"/>
    </fragment>

    <fragment
        android:id="@+id/moreFragment"
        android:name="com.example.androidfinal.core.ui.fragments.MoreFragment"
        android:label="MoreFragment">
        <action
            android:id="@+id/action_moreFragment_to_bookmarksFragment"
            app:destination="@id/bookmarksFragment" />
        <action
            android:id="@+id/action_moreFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookmarksFragment"
        android:name="com.example.androidfinal.core.ui.fragments.BookmarksFragment"
        android:label="BookmarksFragment">
        <action
            android:id="@+id/action_bookmarksFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.androidfinal.core.ui.fragments.SearchFragment"
        android:label="SearchFragment" />
</navigation>